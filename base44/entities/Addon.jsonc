{
  "name": "Addon",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "Torrent"
    },
    "description": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "installed": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}