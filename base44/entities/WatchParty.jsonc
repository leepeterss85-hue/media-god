{
  "name": "WatchParty",
  "type": "object",
  "properties": {
    "room_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "poster_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "is_playing": {
      "type": "boolean",
      "default": false
    },
    "current_time": {
      "type": "number",
      "default": 0
    },
    "last_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "room_code",
    "title",
    "video_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}