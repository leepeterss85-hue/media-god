{
  "name": "GuestDebridCredential",
  "type": "object",
  "properties": {
    "device_key_hash": {
      "type": "string"
    },
    "rd_token": {
      "type": "string"
    },
    "rd_refresh_token": {
      "type": "string"
    },
    "rd_client_id": {
      "type": "string"
    },
    "rd_client_secret": {
      "type": "string"
    },
    "rd_token_expires_at": {
      "type": "string"
    },
    "rd_connected_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "device_key_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__disabled__"
      }
    },
    "read": {
      "user_condition": {
        "role": "__disabled__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__disabled__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__disabled__"
      }
    }
  }
}