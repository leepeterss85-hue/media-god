{
  "name": "Channel",
  "type": "object",
  "properties": {
    "number": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "quality": {
      "type": "string",
      "default": "HD"
    },
    "viewers": {
      "type": "integer",
      "default": 0
    },
    "region": {
      "type": "string",
      "default": "UK"
    },
    "group": {
      "type": "string",
      "default": "TV"
    }
  },
  "required": [
    "name"
  ]
}